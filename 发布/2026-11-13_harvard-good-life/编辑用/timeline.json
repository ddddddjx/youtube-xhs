 "subs": [
  {
   "a": 0.1,
   "b": 4.2,
   "zh": "如果现在就为未来的自己投资，",
   "en": "If you were going to invest now in your future best self,",
   "kind": "clip"
  },
  {
   "a": 4.9,
   "b": 7.8,
   "zh": "你会把时间和精力放在哪里？",
   "en": "where would you put your time and your energy?",
   "kind": "clip"
  },
  {
   "a": 8.36,
   "b": 11.31,
   "zh": "这是 TED 上被看了五千多万次的一场演讲",
   "kind": "nar"
  },
  {
   "a": 11.844,
   "b": 13.475,
   "zh": "讲的人叫 Robert Waldinger",
   "kind": "nar"
  },
  {
   "a": 13.525,
   "b": 15.484,
   "zh": "哈佛医学院的精神科教授",
   "kind": "nar"
  },
  {
   "a": 16.007,
   "b": 17.414,
   "zh": "他手里有一项研究",
   "kind": "nar"
  },
  {
   "a": 17.464,
   "b": 18.872,
   "zh": "从一九三八年开始",
   "kind": "nar"
  },
  {
   "a": 18.922,
   "b": 20.147,
   "zh": "一直做到了今天",
   "kind": "nar"
  },
  {
   "a": 20.753,
   "b": 27.653,
   "zh": "哈佛成人发展研究，可能是同类研究里做得最久的一项。",
   "en": "The Harvard Study of Adult Development may be the longest study of adult life ever done.",
   "kind": "clip"
  },
  {
   "a": 28.753,
   "b": 34.953,
   "zh": "75 年里，我们跟踪了 724 位男性的一生。",
   "en": "For 75 years, we've tracked the lives of 724 men.",
   "kind": "clip"
  },
  {
   "a": 35.523,
   "b": 37.303,
   "zh": "七百多个人，分成两组",
   "kind": "nar"
  },
  {
   "a": 37.873,
   "b": 39.753,
   "zh": "一组是哈佛的大二学生",
   "kind": "nar"
  },
  {
   "a": 40.323,
   "b": 43.693,
   "zh": "另一组，是波士顿最穷街区的男孩",
   "kind": "nar"
  },
  {
   "a": 44.273,
   "b": 46.678,
   "zh": "每隔两年，研究者就上门一次",
   "kind": "nar"
  },
  {
   "a": 46.728,
   "b": 49.133,
   "zh": "问卷、病历、抽血、扫描大脑",
   "kind": "nar"
  },
  {
   "a": 49.693,
   "b": 52.973,
   "zh": "一跟，就跟到了他们九十多岁",
   "kind": "nar"
  },
  {
   "a": 53.476,
   "b": 56.586,
   "zh": "七十五年，几万页记录",
   "kind": "nar"
  },
  {
   "a": 56.636,
   "b": 60.695,
   "zh": "最后能说清楚的，只有一句话",
   "kind": "nar"
  },
  {
   "a": 61.295,
   "b": 67.195,
   "zh": "结论跟财富、名望、更拼命工作都没有关系。",
   "en": "The lessons aren't about wealth or fame or working harder and harder.",
   "kind": "clip"
  },
  {
   "a": 68.095,
   "b": 73.695,
   "zh": "这项 75 年的研究，给出的最明确的一条是：",
   "en": "The clearest message that we get from this 75-year study is this:",
   "kind": "clip"
  },
  {
   "a": 74.695,
   "b": 79.795,
   "zh": "好的关系让人更快乐、更健康。就这样。",
   "en": "Good relationships keep us happier and healthier. Period.",
   "kind": "clip"
  },
  {
   "a": 80.795,
   "b": 85.495,
   "zh": "人可以在人群中孤独，也可以在婚姻里孤独。",
   "en": "And we know that you can be lonely in a crowd and you can be lonely in a marriage.",
   "kind": "clip"
  },
  {
   "a": 86.495,
   "b": 91.395,
   "zh": "所以第二条结论是：不只看你有多少朋友，",
   "en": "So the second big lesson is that it's not just the number of friends you have,",
   "kind": "clip"
  },
  {
   "a": 91.795,
   "b": 94.695,
   "zh": "也不只看你有没有伴侣，",
   "en": "and it's not whether or not you're in a committed relationship,",
   "kind": "clip"
  },
  {
   "a": 94.795,
   "b": 99.595,
   "zh": "真正要紧的，是亲密关系的质量。",
   "en": "but it's the quality of your close relationships that matters.",
   "kind": "clip"
  },
  {
   "a": 100.165,
   "b": 101.615,
   "zh": "他把这句话拆成三层",
   "kind": "nar"
  },
  {
   "a": 102.335,
   "b": 104.765,
   "zh": "第一层，孤独伤的是身体",
   "kind": "nar"
  },
  {
   "a": 105.505,
   "b": 108.845,
   "zh": "第二层，五十岁，就能预测八十岁",
   "kind": "nar"
  },
  {
   "a": 109.575,
   "b": 112.465,
   "zh": "第三层，靠得住的人，护住的是大脑",
   "kind": "nar"
  },
  {
   "a": 113.147,
   "b": 115.027,
   "zh": "先看孤独的那一头",
   "kind": "nar"
  },
  {
   "a": 115.635,
   "b": 119.435,
   "zh": "第一，跟人有连接，对我们真的有好处；",
   "en": "The first is that social connections are really good for us,",
   "kind": "clip"
  },
  {
   "a": 119.535,
   "b": 121.335,
   "zh": "而孤独会要人命。",
   "en": "and that loneliness kills.",
   "kind": "clip"
  },
  {
   "a": 121.535,
   "b": 125.735,
   "zh": "那些比自己希望的更孤立的人，",
   "en": "People who are more isolated than they want to be from others",
   "kind": "clip"
  },
  {
   "a": 126.535,
   "b": 129.235,
   "zh": "没那么快乐，",
   "en": "find that they are less happy,",
   "kind": "clip"
  },
  {
   "a": 130.135,
   "b": 132.635,
   "zh": "中年时健康更早开始下滑，",
   "en": "their health declines earlier in midlife,",
   "kind": "clip"
  },
  {
   "a": 133.135,
   "b": 135.135,
   "zh": "大脑功能衰退得更早，",
   "en": "their brain functioning declines sooner",
   "kind": "clip"
  },
  {
   "a": 135.235,
   "b": 138.835,
   "zh": "寿命也比不孤独的人短。",
   "en": "and they live shorter lives than people who are not lonely.",
   "kind": "clip"
  },
  {
   "a": 139.405,
   "b": 141.355,
   "zh": "孤独不只是一种心情",
   "kind": "nar"
  },
  {
   "a": 141.995,
   "b": 145.705,
   "zh": "身体和大脑，都会提前衰老",
   "kind": "nar"
  },
  {
   "a": 146.379,
   "b": 149.889,
   "zh": "等这批人活到八十多岁，研究者做了一件事",
   "kind": "nar"
  },
  {
   "a": 150.459,
   "b": 153.836,
   "zh": "他们翻出每个人五十岁时的全部记录",
   "kind": "nar"
  },
  {
   "a": 153.886,
   "b": 155.549,
   "zh": "想找出到底哪一项",
   "kind": "nar"
  },
  {
   "a": 155.599,
   "b": 157.049,
   "zh": "能提前预测晚年",
   "kind": "nar"
  },
  {
   "a": 157.653,
   "b": 162.853,
   "zh": "把他们 50 岁时的所有资料放在一起看，",
   "en": "When we gathered together everything we knew about them at age 50,",
   "kind": "clip"
  },
  {
   "a": 163.853,
   "b": 168.753,
   "zh": "预测他们怎样变老的，不是中年的胆固醇水平，",
   "en": "it wasn't their middle-age cholesterol levels that predicted how they were going to grow old.",
   "kind": "clip"
  },
  {
   "a": 169.453,
   "b": 172.753,
   "zh": "是他们对自己的关系有多满意。",
   "en": "It was how satisfied they were in their relationships.",
   "kind": "clip"
  },
  {
   "a": 172.953,
   "b": 180.653,
   "zh": "50 岁时对关系最满意的人，80 岁时最健康。",
   "en": "The people most satisfied in their relationships at age 50 were the healthiest at age 80.",
   "kind": "clip"
  },
  {
   "a": 181.203,
   "b": 185.903,
   "zh": "五十岁时关系好不好，比胆固醇，更能预测八十岁",
   "kind": "nar"
  },
  {
   "a": 186.579,
   "b": 188.309,
   "zh": "第三层，在大脑里",
   "kind": "nar"
  },
  {
   "a": 188.81,
   "b": 197.11,
   "zh": "80 多岁时，有一段让人安心的关系，是一种保护。",
   "en": "Being in a securely attached relationship to another person in your 80s is protective.",
   "kind": "clip"
  },
  {
   "a": 197.31,
   "b": 203.31,
   "zh": "真心觉得需要的时候能指望对方的人，",
   "en": "People who really feel they can count on the other person in times of need,",
   "kind": "clip"
  },
  {
   "a": 203.51,
   "b": 206.21,
   "zh": "记忆力保持清晰的时间更长。",
   "en": "those people's memories stay sharper longer.",
   "kind": "clip"
  },
  {
   "a": 206.76,
   "b": 209.614,
   "zh": "好的关系，不等于从不吵架",
   "kind": "nar"
  },
  {
   "a": 209.664,
   "b": 213.002,
   "zh": "有些八十多岁的夫妻，天天拌嘴",
   "kind": "nar"
  },
  {
   "a": 213.052,
   "b": 218.326,
   "zh": "可只要相信关键时刻对方靠得住，记忆就不受影响",
   "kind": "nar"
  },
  {
   "a": 218.846,
   "b": 220.286,
   "zh": "吵不吵架不要紧",
   "kind": "nar"
  },
  {
   "a": 221.226,
   "b": 224.786,
   "zh": "难的时候有人靠得住，才要紧",
   "kind": "nar"
  },
  {
   "a": 225.46,
   "b": 226.96,
   "zh": "他给的办法，都很小",
   "kind": "nar"
  },
  {
   "a": 227.562,
   "b": 232.862,
   "zh": "可以简单到把看屏幕的时间，换成跟人在一起；",
   "en": "It might be something as simple as replacing screen time with people time,",
   "kind": "clip"
  },
  {
   "a": 234.162,
   "b": 240.262,
   "zh": "或者一起做点新鲜事，散步、约会，让关系重新活起来；",
   "en": "or livening up a stale relationship by doing something new together, long walks or date nights,",
   "kind": "clip"
  },
  {
   "a": 241.062,
   "b": 245.862,
   "zh": "或者联系那位多年没说话的家人。",
   "en": "or reaching out to that family member who you haven't spoken to in years.",
   "kind": "clip"
  },
  {
   "a": 246.412,
   "b": 249.602,
   "zh": "他说，别跟屏幕聊天，去跟人聊天",
   "kind": "nar"
  },
  {
   "a": 250.202,
   "b": 250.956,
   "zh": "十年过去",
   "kind": "nar"
  },
  {
   "a": 251.006,
   "b": 253.367,
   "zh": "很多人每天聊得最多的对象",
   "kind": "nar"
  },
  {
   "a": 253.417,
   "b": 254.492,
   "zh": "变成了 AI",
   "kind": "nar"
  },
  {
   "a": 255.032,
   "b": 257.972,
   "zh": "能交给 AI 的事，都交出去",
   "kind": "nar"
  },
  {
   "a": 258.762,
   "b": 262.512,
   "zh": "省下来的时间，留给靠得住的人",
   "kind": "nar"
  }
 ],
