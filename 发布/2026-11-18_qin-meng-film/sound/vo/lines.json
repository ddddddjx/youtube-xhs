{
 "01": {
  "who": "使者",
  "text": "蒙恬罪当死，请即刻领旨。",
  "raw": 3.25,
  "dur": 2.19,
  "tempo": 1.275,
  "shot": 3
 },
 "04": {
  "who": "旁白",
  "text": "公元前二四七年，质子归秦。",
  "raw": 3.24,
  "dur": 2.79,
  "tempo": 1.0,
  "shot": 4
 },
 "05": {
  "who": "蒙恬少年",
  "text": "你与我年岁相仿，可敢一战？",
  "raw": 2.54,
  "dur": 2.19,
  "tempo": 1.0,
  "shot": 3
 },
 "06": {
  "who": "嬴政少年",
  "text": "你知道我是谁？",
  "raw": 1.37,
  "dur": 1.06,
  "tempo": 1.0,
  "shot": 3
 },
 "07": {
  "who": "蒙恬少年",
  "text": "知道。可你走的，是条荆棘之路。",
  "raw": 4.15,
  "dur": 3.24,
  "tempo": 1.168,
  "shot": 4
 },
 "16": {
  "who": "蒙恬少年",
  "text": "好！很少遇上你这样的对手。",
  "raw": 2.86,
  "dur": 2.08,
  "tempo": 1.123,
  "shot": 3
 },
 "17": {
  "who": "嬴政少年",
  "text": "守御如山，只少几分全局思量。",
  "raw": 3.31,
  "dur": 2.13,
  "tempo": 1.297,
  "shot": 3
 },
 "18": {
  "who": "嬴政少年",
  "text": "天下割据已久。我要混一宇内，让天下再无分疆。",
  "raw": 5.05,
  "dur": 4.12,
  "tempo": 1.11,
  "shot": 5
 },
 "19": {
  "who": "蒙恬少年",
  "text": "若有那一日，我愿为你执戈列阵。",
  "raw": 3.35,
  "dur": 2.29,
  "tempo": 1.3,
  "shot": 3
 },
 "20": {
  "who": "嬴政少年",
  "text": "君子一诺，我记下了。",
  "raw": 2.26,
  "dur": 1.67,
  "tempo": 1.0,
  "shot": 3
 },
 "21": {
  "who": "旁白",
  "text": "九年后，少年成了秦王。",
  "raw": 3.25,
  "dur": 2.16,
  "tempo": 1.273,
  "shot": 3
 },
 "22": {
  "who": "嬴政秦王",
  "text": "秦积六世之余威，可六国仍在。",
  "raw": 3.78,
  "dur": 2.58,
  "tempo": 1.3,
  "shot": 3
 },
 "23": {
  "who": "蒙恬将军",
  "text": "先攻一国，五国必援。",
  "raw": 2.52,
  "dur": 2.04,
  "tempo": 1.0,
  "shot": 3
 },
 "24": {
  "who": "嬴政秦王",
  "text": "我不愿老秦子弟，白白填于沟壑。",
  "raw": 3.4,
  "dur": 2.24,
  "tempo": 1.3,
  "shot": 3
 },
 "25": {
  "who": "蒙恬将军",
  "text": "臣必持阵慎战，不负所托。",
  "raw": 3.25,
  "dur": 2.13,
  "tempo": 1.275,
  "shot": 3
 },
 "26": {
  "who": "嬴政秦王",
  "text": "唯有你，懂我惜兵之心。",
  "raw": 2.64,
  "dur": 2.15,
  "tempo": 1.037,
  "shot": 3
 }
}