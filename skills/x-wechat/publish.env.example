# 复制到 Mac 的 ~/.config/krypto-publish.env，填好后 chmod 600。这个文件不进仓库。
#
# X：developer.x.com → Projects & Apps → 你的 App
#   User authentication settings 里 App permissions 选 Read and write（选完要重新生成下面两个 Access Token）
#   Keys and tokens 页：API Key and Secret → 前两项；Access Token and Secret → 后两项
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# 公众号：mp.weixin.qq.com → 设置与开发 → 开发接口管理 → 基本配置
#   AppSecret 只显示一次，重置后旧的立刻失效
#   同一页的 IP 白名单 加上 Mac 的出口 IP（publish.py check 报 40164 时会告诉你是哪个）
WECHAT_APPID=
WECHAT_SECRET=
